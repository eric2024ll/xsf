# 小書房数据目录，默认 ~/xsf-data/
# export XSF_DATA=/path/to/data

# SAG 语义检索 (可选). 未设置 = 禁用, 搜索仅 FTS5
# export XSF_SAG_URL=http://localhost:8000
# export XSF_SAG_TIMEOUT=15
# export XSF_SAG_USER=xsf
# export XSF_SAG_PASSWORD=xsf12345   # SAG 首用户密码 (>=8 字符, 首次自动注册)

# MCP 适配器专用 (xsf-mcp)
# export XSF_BASE_URL=http://localhost:8090
# export XSF_AUTH_TOKEN=你的登录密码
