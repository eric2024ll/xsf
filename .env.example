# 小書房数据目录, 默认 ~/xsf-data/
# export XSF_DATA=/path/to/data
# 文献文件/上传目录与 DB 目录重定向 (高级, 通常不用)
# export XSF_COLLECTIONS_DIR=/path/to/collections
# export XSF_DB_DIR=/path/to/db

# Web 绑定地址与端口 (默认 127.0.0.1:8090, 便携版端口占用自动顺延)
# export XSF_HOST=127.0.0.1
# export XSF_PORT=8090

# 登录密码 (未设 = 无需登录)
# export XSF_AUTH_TOKEN=change-me

# MCP 适配器 (xsf-mcp) 连接的服务地址
# export XSF_BASE_URL=http://localhost:8090
